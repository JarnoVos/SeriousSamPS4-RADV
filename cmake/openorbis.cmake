set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(SERIOUSSAM_PS4 ON CACHE BOOL "Build for OpenOrbis")

if(DEFINED ENV{OO_PS4_TOOLCHAIN})
  set(OO_PS4_TOOLCHAIN "$ENV{OO_PS4_TOOLCHAIN}")
else()
  set(OO_PS4_TOOLCHAIN /opt/openorbis/OpenOrbis/PS4Toolchain)
endif()
if(NOT EXISTS "${OO_PS4_TOOLCHAIN}/lib/crt1.o")
  message(FATAL_ERROR "OpenOrbis toolchain not found: ${OO_PS4_TOOLCHAIN}")
endif()

if(DEFINED ENV{SS_PS4_CLANG})
  set(CMAKE_C_COMPILER "$ENV{SS_PS4_CLANG}")
  set(CMAKE_CXX_COMPILER "$ENV{SS_PS4_CLANGXX}")
  set(CMAKE_AR "$ENV{SS_PS4_LLVM_AR}")
  set(CMAKE_RANLIB "$ENV{SS_PS4_LLVM_RANLIB}")
else()
  set(CMAKE_C_COMPILER clang)
  set(CMAKE_CXX_COMPILER clang++)
  set(CMAKE_AR llvm-ar)
  set(CMAKE_RANLIB llvm-ranlib)
endif()
set(CMAKE_C_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_SYSROOT "${OO_PS4_TOOLCHAIN}")
set(CMAKE_C_FLAGS_INIT "-fPIC -march=btver2 -D__PS4__ -D__ORBIS__ -D_BSD_SOURCE -isystem ${OO_PS4_TOOLCHAIN}/include")
set(CMAKE_CXX_FLAGS_INIT "-fPIC -march=btver2 -D__PS4__ -D__ORBIS__ -D_BSD_SOURCE -D_LIBCPP_HAS_NO_LOCALE -nostdinc++ -isystem ${OO_PS4_TOOLCHAIN}/include/c++/v1 -isystem ${OO_PS4_TOOLCHAIN}/include")
set(SS_PS4_LLD "lld")
if(DEFINED ENV{SS_PS4_LLD})
  set(SS_PS4_LLD "$ENV{SS_PS4_LLD}")
endif()
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=${SS_PS4_LLD} -nostdlib -Wl,-pie -Wl,--script=${OO_PS4_TOOLCHAIN}/link.x -Wl,--eh-frame-hdr -Wl,-z,max-page-size=0x4000 -L${OO_PS4_TOOLCHAIN}/lib ${OO_PS4_TOOLCHAIN}/lib/crt1.o")
set(CMAKE_C_STANDARD_LIBRARIES "-lc -lkernel")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lc++abi -lunwind -lc -lSceUserService -lScePad -lSceAudioOut -lSceVideoOut -lSceNet -lkernel")
# RADV builds use clang 21 against Dolphin's libc++ 21 sysroot. The OpenGNM boot leaves SS_PS4_SYSROOT unset.
if(DEFINED ENV{SS_PS4_SYSROOT})
  set(_ss_sysroot "$ENV{SS_PS4_SYSROOT}")
  string(REPLACE "--script=${OO_PS4_TOOLCHAIN}/link.x" "--script=${CMAKE_CURRENT_LIST_DIR}/ps4-link-radv.x" CMAKE_EXE_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
  string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -Wl,--no-dynamic-linker")
  set(CMAKE_C_FLAGS_INIT "-fPIC -funwind-tables -march=btver2 -D_GNU_SOURCE -D__PS4__ -D__OPENORBIS__ -D__ORBIS__ -DPS4 -D__BSD_VISIBLE -D_BSD_SOURCE -isysroot ${OO_PS4_TOOLCHAIN} -isystem ${_ss_sysroot}/libc-overlay -isystem ${OO_PS4_TOOLCHAIN}/include -I${OO_PS4_TOOLCHAIN}/usr/include")
  set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -isystem ${_ss_sysroot}/include/c++/v1 ${CMAKE_C_FLAGS_INIT}")
  set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_C_STANDARD_LIBRARIES} ${_ss_sysroot}/lib/libc++.a ${_ss_sysroot}/lib/libc++abi.a ${OO_PS4_TOOLCHAIN}/lib/libunwind.a -lSceUserService -lScePad -lSceAudioOut -lSceVideoOut -lSceNet -lkernel -lSceLibcInternal")
endif()
set(CMAKE_FIND_ROOT_PATH "${OO_PS4_TOOLCHAIN}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# The SDK ships SDL2 headers and a static PS4 port.
set(SDL2_INCLUDE_DIR "${OO_PS4_TOOLCHAIN}/include/SDL2" CACHE PATH "PS4 SDL2 headers")
set(SDL2_LIBRARY_TEMP "${OO_PS4_TOOLCHAIN}/lib/libSDL2.a" CACHE FILEPATH "PS4 SDL2 library")
